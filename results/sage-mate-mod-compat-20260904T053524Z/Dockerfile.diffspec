      ai.vllm-hust.vllm-ascend.commit="4e57439e58ed3d78e675f9fd7b4614fb183c5394" \
      ai.vllm-hust.diffspec.commit="c78f55c7e4923da342f2fc52c2cb509c150e5363" \
