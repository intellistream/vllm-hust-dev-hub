FROM sage-mate/vllm-ascend-hust:core-762f85b3-plugin-4e57439e-hybrid4-cann9.1

COPY artifacts/vllm-0.28.1rc1.dev319+g762f85b31.empty-cp312-cp312-linux_aarch64.whl /tmp/candidate/
COPY artifacts/vllm_ascend-0.25.1rc1+hust.20260903.4-cp312-cp312-linux_aarch64.whl /tmp/candidate/
COPY artifacts-diff-r007/vllm_diffspec-0.3.0-py3-none-any.whl /tmp/candidate/

RUN /usr/local/python3.12.13/bin/python -m pip install --no-deps --force-reinstall \
      /tmp/candidate/vllm-*.whl \
      /tmp/candidate/vllm_ascend-*.whl \
      /tmp/candidate/vllm_diffspec-*.whl \
    && TORCH_DEVICE_BACKEND_AUTOLOAD=0 VLLM_PLUGINS=none \
      /usr/local/python3.12.13/bin/python -c \
      'import diffspec; import importlib.metadata as m; assert m.version("vllm-diffspec") == "0.3.0"' \
    && rm -rf /tmp/candidate

