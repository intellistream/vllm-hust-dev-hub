FROM sage-mate/vllm-ascend-hust:core-762f85b3-plugin-4e57439e-hybrid4-cann9.1

COPY artifacts/vllm-0.28.1rc1.dev319+g762f85b31.empty-cp312-cp312-linux_aarch64.whl /tmp/candidate/
COPY artifacts/vllm_ascend-0.25.1rc1+hust.20260903.4-cp312-cp312-linux_aarch64.whl /tmp/candidate/
COPY artifacts/vllm_hust_ext-0.2.0.dev0-py3-none-any.whl /tmp/candidate/
COPY artifacts-r002/bidkv-0.2.0-py3-none-any.whl /tmp/candidate/

RUN python3 -m pip install --no-deps --force-reinstall \
      /tmp/candidate/vllm-*.whl \
      /tmp/candidate/vllm_ascend-*.whl \
      /tmp/candidate/vllm_hust_ext-*.whl \
      /tmp/candidate/bidkv-*.whl \
    && VLLM_PLUGINS=none TORCH_DEVICE_BACKEND_AUTOLOAD=0 python3 -c 'import importlib.metadata as m; from vllm.v1.core.sched.preemption import PREEMPTION_POLICY_API_VERSION; from bidkv.adapters.vllm_hust.selector import BidkvPreemptionPolicy; assert PREEMPTION_POLICY_API_VERSION == "1.0"; assert BidkvPreemptionPolicy; eps=m.entry_points(); assert "org.vllm-hust.bidkv" in {e.name for e in eps.select(group="vllm_hust.extension_bundles")}' \
    && rm -rf /tmp/candidate

LABEL org.opencontainers.image.title="Sage Mate BidKV qualification candidate" \
      org.opencontainers.image.revision="bbfddaa74c11622c7bb3f3e742f442faeb6f17e1:2c8c722107a54127999a64c4eb0ec86139df8c26:f297a8d9817e66360737749af89e996e3d35b637" \
      ai.vllm-hust.evidence="unqualified-candidate" \
      ai.vllm-hust.vllm-core.commit="bbfddaa74c11622c7bb3f3e742f442faeb6f17e1" \
      ai.vllm-hust.vllm-ascend.commit="2c8c722107a54127999a64c4eb0ec86139df8c26" \
      ai.vllm-hust.extension-manager.commit="a8586ab17adab3b76e53b4abaf668564275e0fcb" \
      ai.vllm-hust.bidkv.commit="f297a8d9817e66360737749af89e996e3d35b637"
