# Non-secret DiffSpec smoke profile for one Ascend NPU.
#
# Required caller environment:
#   VLLM_HUST_API_KEY
#   DIFFSPEC_TARGET_MODEL
#   DIFFSPEC_DRAFT_MODEL

VLLM_ENGINE_SYSTEMD_UNIT=vllm-hust-diffspec-smoke-npu1.service
VLLM_ENGINE_CONTAINER=vllm-hust-diffspec-smoke-npu1
VLLM_ENGINE_PORT=18167

VLLM_ENGINE_NPU_DEVICES=0
ASCEND_RT_VISIBLE_DEVICES=0
ASCEND_VISIBLE_DEVICES=0

VLLM_ENGINE_CONDA_ENV=vllm-hust-dev
VLLM_ENGINE_TP_SIZE=1
VLLM_ENGINE_SERVED_MODEL_NAME=diffspec-smoke

VLLM_ENGINE_MAX_MODEL_LEN=32768
VLLM_ENGINE_MAX_NUM_BATCHED_TOKENS=32768
VLLM_ENGINE_MAX_NUM_SEQS=1
VLLM_ENGINE_GPU_MEM_UTIL=0.90
VLLM_ENGINE_DTYPE=bfloat16

VLLM_ENGINE_ENABLE_PREFIX_CACHING=0
VLLM_ENGINE_ENABLE_CHUNKED_PREFILL=0
VLLM_ENGINE_ENFORCE_EAGER=1

VLLM_OPTIMIZATION_REPO_CONTAINER=/workspace/vllm-ascend-hust-diffspec
VLLM_OPTIMIZATION_SRC_SUBDIR=.
VLLM_OPTIMIZATION_PLUGIN=diffspec
VLLM_PLUGINS=ascend,diffspec

COMPILE_CUSTOM_KERNELS=1
TORCH_DEVICE_BACKEND_AUTOLOAD=0
VLLM_ASCEND_TORCH_PREFLIGHT=0
