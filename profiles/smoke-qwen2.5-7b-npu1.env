# Non-secret smoke-test profile for a single NPU.
# Usage:
#   VLLM_ENGINE_ENV_FILE=profiles/smoke-qwen2.5-7b-npu1.env ./manage.sh start
#
# Keep secrets in local .env or the caller environment. This file should only
# contain reproducible launch settings.

VLLM_ENGINE_SYSTEMD_UNIT=codex-vllm-hust-smoke-npu1.service
VLLM_ENGINE_CONTAINER=codex-vllm-hust-smoke-npu1
VLLM_ENGINE_PORT=18166
VLLM_ENGINE_NPU_DEVICES=1
ASCEND_RT_VISIBLE_DEVICES=1
ASCEND_VISIBLE_DEVICES=1

VLLM_ENGINE_TP_SIZE=1
VLLM_ENGINE_MODEL_PATH=/data/shared_models/Qwen2.5-7B-Instruct
VLLM_ENGINE_SERVED_MODEL_NAME=codex-qwen2.5-7b
VLLM_ENGINE_MAX_MODEL_LEN=4096
VLLM_ENGINE_MAX_NUM_BATCHED_TOKENS=4096
VLLM_ENGINE_MAX_NUM_SEQS=4
VLLM_ENGINE_GPU_MEM_UTIL=0.75

VLLM_ENGINE_ENABLE_PREFIX_CACHING=1
VLLM_ENGINE_ENABLE_CHUNKED_PREFILL=1
VLLM_ENGINE_ENFORCE_EAGER=0
VLLM_ENGINE_COMPILATION_CONFIG={"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[1,2,4],"max_cudagraph_capture_size":4}
VLLM_ENGINE_EXTRA_ARGS_JSON=["--additional-config","{\"ascend_compilation_config\":{\"fuse_norm_quant\":false,\"fuse_qknorm_rope\":false,\"fuse_allreduce_rms\":false,\"fuse_muls_add\":false}}"]
VLLM_ENGINE_EXTRA_ENV_KEYS=
VLLM_ENGINE_EXTRA_ENV_PREFIXES=
VLLM_ENGINE_PYTHONPATH=/workspace/vllm-hust:/workspace/vllm-ascend-hust
VLLM_ENGINE_CONTAINER_LOG_FILE=/tmp/codex-vllm-hust-smoke-npu1.redacted.log

VLLM_PLUGINS=ascend
COMPILE_CUSTOM_KERNELS=1
TORCH_DEVICE_BACKEND_AUTOLOAD=0
VLLM_ASCEND_TORCH_PREFLIGHT=0
VLLM_USE_SIMPLE_KV_OFFLOAD=0
VLLM_DEBUG_PREFIX_CACHE_TRACE=0
