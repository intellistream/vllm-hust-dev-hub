[Unit]
Description=vLLM-HUST 112 evaluation request API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shuhao
Group=shuhao
WorkingDirectory=/opt/vllm-hust-evaluation/dev-hub
EnvironmentFile=/etc/vllm-hust-evaluation/secrets.env
ExecStart=/usr/bin/python3 -m scripts.evaluation_machine.server --config /etc/vllm-hust-evaluation/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/vllm-hust-evaluation

[Install]
WantedBy=multi-user.target
