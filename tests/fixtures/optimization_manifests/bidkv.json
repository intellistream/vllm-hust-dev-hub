{
  "schema_version": 1,
  "id": "bidkv",
  "repository": "vllm-hust-bidkv",
  "source_subdir": "src",
  "entrypoint": {"group": "vllm_hust.extension_bundles", "name": "org.vllm-hust.bidkv"},
  "parameters": {},
  "activation": {
    "vllm_plugins": ["ascend"],
    "environment": {
      "BIDKV_UTILITY_ENABLE": "1",
      "BIDKV_UTILITY_STRATEGY": "bidkv",
      "BIDKV_UTILITY_LIVENESS_PREEMPTIONS": "2",
      "BIDKV_UTILITY_CASCADE_GAIN_RATIO": "1.25"
    },
    "extra_env_prefixes": ["BIDKV_UTILITY_"],
    "extra_args": [
      "--preemption-policy",
      "bidkv.adapters.vllm_hust.selector.BidkvPreemptionPolicy"
    ]
  },
  "compatibility": {"incompatible_with": ["bidkv-legacy"]}
}
