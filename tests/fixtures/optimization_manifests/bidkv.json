{
  "schema_version": 1,
  "id": "bidkv",
  "repository": "vllm-hust-bidkv",
  "source_subdir": "src",
  "entrypoint": {"group": "vllm.victim_selector", "name": "bidkv"},
  "parameters": {},
  "activation": {
    "vllm_plugins": ["ascend"],
    "environment": {"BIDKV_UTILITY_ENABLE": "1"},
    "extra_env_prefixes": ["BIDKV_UTILITY_"],
    "extra_args": [
      "--additional-config",
      {"victim_selector_plugin": "bidkv", "enable_utility_victim_selection": true}
    ]
  },
  "compatibility": {"incompatible_with": ["bidkv-legacy"]}
}
