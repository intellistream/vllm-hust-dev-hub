# 复制本文件为 .env 并填入真实值：cp .env.template .env

# GitHub Personal Access Token (required for cloning private sagellm-* repos)
# Required scopes (classic token): repo, read:org
GITHUB_TOKEN=

# Optional: Hugging Face token for model download
HF_ENDPOINT=
HF_TOKEN=

# Optional: PyPI token for private publishing workflows
PYPI_TOKEN=

# --- Container SSH (used by scripts/ascend-container-runtime.sh) ---
# Required: OS username inside the container
CONTAINER_SSH_USER=
# Optional (defaults shown):
# CONTAINER_SSH_PORT=2237
# CONTAINER_SSH_AUTHORIZED_KEYS=/workspace/.ssh/authorized_keys
